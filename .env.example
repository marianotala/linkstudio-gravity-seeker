# --- Google (Geocoding API + Places API New habilitadas) ---
# Vive SOLO en el servidor: el cliente nunca la recibe.
GOOGLE_MAPS_KEY=tu_api_key_de_google

# --- DENUE (INEGI) ---
# Token gratuito para la API de DENUE (censo territorial). Solicítalo en
# https://www.inegi.org.mx/servicios/api_denue.aspx — vive SOLO en el
# servidor, igual que la key de Google.
DENUE_TOKEN=tu_token_de_denue

# --- Supabase (proyecto Seeker) ---
# URL y anon key son públicas (van al navegador); el acceso a datos
# lo controla RLS. Cópialas de Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Service role: SOLO servidor, se salta RLS. No se usa en la app hoy;
# resérvala para scripts de administración. NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Límites y frescura (opcionales) ---
# Límites diarios por usuario (los admin no tienen límite).
DAILY_SEARCH_LIMIT=50
DAILY_CELL_LIMIT=300
# Semáforo de frescura de censos Google (días): verde < VERDE,
# amarillo VERDE-AMARILLO, rojo > AMARILLO.
NEXT_PUBLIC_CENSO_VERDE_DIAS=30
NEXT_PUBLIC_CENSO_AMARILLO_DIAS=90

# --- Universos demográficos (fase 5) ---
# Factores del universo direccionable ESTIMADO: 18+ × smartphone × match.
FACTOR_SMARTPHONE=0.82
FACTOR_MATCH=0.65
# Solo para scripts/ingesta-ageb (no la usa la app):
# Supabase → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://usuario:password@host:5432/postgres
